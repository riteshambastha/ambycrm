# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://amby:amby@localhost:5432/ambycrm
DATABASE_URL_SYNC=postgresql://amby:amby@localhost:5432/ambycrm

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Clerk ─────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# ── LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_LLM_MODEL=gpt-4o

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com

# ── Frontend ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CRM Connectors ───────────────────────────────────────────────────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT_ID=common
DYNAMICS_ORG_URL=https://yourorg.crm.dynamics.com
SUGARCRM_BASE_URL=https://yourinstance.sugarondemand.com
SUGARCRM_CLIENT_ID=sugar
SUGARCRM_CLIENT_SECRET=

# ── Workspace Connectors ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Meeting Connectors ───────────────────────────────────────────────
FIREFLIES_API_KEY=
RECALL_API_KEY=
